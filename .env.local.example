# The /exec URL of your deployed Google Apps Script Web App.
# See SETUP_GUIDE.md for step-by-step instructions on how to get this URL.
GOOGLE_SHEET_WEBHOOK_URL=https://script.google.com/macros/s/YOUR_SCRIPT_ID_HERE/exec
